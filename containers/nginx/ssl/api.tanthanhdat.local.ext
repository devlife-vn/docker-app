authorityKeyIdentifier=keyid,issuer
basicConstraints=CA:FALSE
keyUsage = digitalSignature, nonRepudiation, keyEncipherment, dataEncipherment
subjectAltName = @alt_names
[alt_names]
DNS.1 = api.tanthanhdat.local # Be sure to include the domain name here because Common Name is not so commonly honoured by itself
DNS.2 = bar.api.tanthanhdat.local # Optionally, add additional domains (I've added a subdomain here)
