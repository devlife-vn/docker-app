### APP CONFIG
DOCKER_NAME=tms-
APP_CODE_PATH_CONTAINER=/var/www
APP_CODE_PATH_HOST=../ttd/web/
APP_DOMAIN_NAME=tanthanhdat.local
WORKING_DIR=./src
SOURCE_CLIENT_FOLDER=authtanthanhdat/
SOURCE_API_FOLDER=api/
SOURCE_JOB_FOLDER=job/
CLIENT_PHP_CONTAINER_NAME=client-php
API_PHP_CONTAINER_NAME=api-php
JOB_PHP_CONTAINER_NAME=job-server
APP_CODE_CONTAINER_FLAG=:cached
DATA_PATH_HOST=~/.tms_docker
CHANGE_SOURCE=false

### NETWORKS
VOLUMES_DRIVER=local
NETWORKS_DRIVER=bridge

### PHP CONFIG
PHP_VERSION=7.4
PMA_DB_ENGINE=mysql
PMA_PORT=8081

### PHPMYADMIN CONFIG
PHPMYADMIN_CONTAINER_NAME=phpmyadmin

### MYSQL CONFIG
MYSQL_CONTAINER_NAME=mysql
WORKSPACE_TIMEZONE=UTC
MYSQL_VERSION=latest
MYSQL_DATABASE=default
MYSQL_USER=default
MYSQL_PASSWORD=secret
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=ftc2018
MYSQL_ENTRYPOINT_INITDB=/mysql/docker-entrypoint-initdb.d

### NGINX CONFIG
NGINX_CONTAINER_NAME=nginx
NGINX_HOST_HTTP_PORT=80
NGINX_HOST_HTTPS_PORT=443
NGINX_HOST_LOG_PATH=./logs/nginx/
NGINX_SITES_PATH=./nginx/sites/
NGINX_API_PHP_UPSTREAM_CONTAINER=${DOCKER_NAME}api-php
NGINX_API_PHP_UPSTREAM_PORT=9000
NGINX_CLIENT_PHP_UPSTREAM_CONTAINER=${DOCKER_NAME}client-php
NGINX_CLIENT_PHP_UPSTREAM_PORT=9000
NGINX_SSL_PATH=./nginx/ssl/
NGINX_PHP_UPSTREAM_PORT=9000
NGINX_PHP_UPSTREAM_CONTAINER=${DOCKER_NAME}${CLIENT_PHP_CONTAINER_NAME}

### REDIS CONFIG
REDIS_CONTAINER_NAME=redis
REDIS_PORT=6379
REDIS_VERSION=latest

### USER CONFIG
PHP_FPM_PUID=1000
PHP_FPM_PGID=1000
